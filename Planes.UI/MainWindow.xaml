<Window x:Class="Planes.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Planes.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid Name="AirportGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>

            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>

            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="8" Name="station1SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="1"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="7" Name="station2SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="2"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="6" Name="station3SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="3"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Stretch" Grid.Row="1"  Grid.ColumnSpan="5" Grid.Column="1" Name="station4SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="4"/>
        </StackPanel>
        <StackPanel  Background="Beige" Grid.RowSpan="2"  Grid.Row="1" Grid.Column="1" Name="station5SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="5"/>

        </StackPanel>
        <StackPanel Background="Beige" VerticalAlignment="Stretch" Grid.Row="4" Grid.Column="2" Name="station6SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="6"/>
        </StackPanel>
        <StackPanel Background="Beige" VerticalAlignment="Stretch" Grid.Row="4" Grid.Column="4" Name="station7SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="7"/>
        </StackPanel>
        <StackPanel Background="Beige" Grid.ColumnSpan="5" Grid.Row="3" Grid.Column="1" Name="runwaySP" Orientation="Vertical"/>

        <StackPanel VerticalAlignment="Stretch" Background="Beige" Grid.RowSpan="2" Grid.Row="1" Grid.Column="5" Name="station8SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="8"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Stretch" Grid.Row="1" Grid.Column="0" Name="station9SP" Orientation="Vertical">
            <Image Height="70"/>
            <TextBlock HorizontalAlignment="Center"/>
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="18" Content="9"/>
        </StackPanel>

        <StackPanel Background="RoyalBlue" VerticalAlignment="Bottom" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Name="terminalSP" Orientation="Vertical">
            <Label VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="22" Content="Terminal"/>

        </StackPanel>
        <Button Content="Go To Flights Window" Grid.Column="7" HorizontalAlignment="Left" Grid.Row="5" VerticalAlignment="Top" Width="144" Click="Button_Click" Height="56" Margin="29,10,0,0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
